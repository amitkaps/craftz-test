{
  "name": "@amitkaps/craftz-test",
  "version": "0.0.0",
  "description": "A package with a static site, started by craftz new to test the release cycle.",
  "homepage": "https://craftz-test.amitkaps.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/craftz-test.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --run",
    "verify": "pnpm check && pnpm prose check && pnpm prose outline && pnpm craftz check && pnpm test && pnpm build && vp build",
    "ship": "craftz deploy",
    "fix": "vp check --fix",
    "prose": "prose",
    "pr": "craftz pr",
    "gone": "craftz gone",
    "craftz": "craftz",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@amitkaps/craftz": "0.9.0",
    "@amitkaps/prose": "0.11.0",
    "@types/node": "26.6.5",
    "publint": "0.3.25",
    "vite-plus": "1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "packageManager": "pnpm@12.15.0"
}
